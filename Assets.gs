/**
 * Assets.gs  (Module 2)
 * AdsPeek logo and partner badge strip, embedded so templates can be built without uploading files.
 * To change the logo later: replace it directly in the Google Docs templates (Insert > Image).
 */

const ADSPEEK_LOGO_PNG_B64 = '';

const PARTNER_STRIP_PNG_B64 = '';

function getLogoBlob_() {
  return Utilities.newBlob(Utilities.base64Decode(ADSPEEK_LOGO_PNG_B64), MimeType.PNG, 'adspeek-logo.png');
}

function getPartnerStripBlob_() {
  return Utilities.newBlob(Utilities.base64Decode(PARTNER_STRIP_PNG_B64), MimeType.PNG, 'adspeek-partners.png');
}
